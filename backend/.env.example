DATABASE_URL=postgresql+psycopg2://timetable:timetable@localhost:5432/timetable
# Shared chat state + real-time event bus. When unset/unreachable the app
# falls back to in-process state (single replica only).
REDIS_URL=redis://localhost:6379/0
CHAT_TTL_SECONDS=3600
EVENTS_CHANNEL=timetable:events
# Per-IP rate limiting (requests/minute and burst bucket size). 0 disables.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40
# Require a valid JWT (?token=) on the SSE event stream.
EVENTS_REQUIRE_AUTH=false
SOLVER_TIME_LIMIT_SECONDS=5.0
# Wall-clock budget the simulated-annealing optimizer may spend on the
# large-instance path (capped by the remaining request budget).
SOLVER_OPTIMIZE_SECONDS=1.5
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000
GEMINI_API_KEY=   # optional: enables Gemini reply polishing in chat (needs google-generativeai)
